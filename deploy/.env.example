# Production settings for deploy/docker-compose.yml. Copy to deploy/.env,
# fill in, and never commit the copy. Step by step: docs/deploy.md.

# The address people type, without https:// - its DNS must point at this server.
# "localhost" works for trying the setup out on your own machine.
DOMAIN=map.example.org

# Long random secrets. Generate each with:
#   openssl rand -base64 48 | tr -d '/+=' | cut -c1-48
# Letters and digits only: they end up inside a database URL.
POSTGRES_PASSWORD=
JWT_SECRET=

# The first superadmin, created by the seed. Change the password after the
# first sign-in (Din konto -> Skift adgangskode).
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Admin

# Which community the seed writes: "bornholm" or "neutral" (see apps/api/src/communities).
COMMUNITY=bornholm

# Backups: kept this many days, made at this hour (UTC).
BACKUP_KEEP_DAYS=14
BACKUP_HOUR=3

# Only change these if 80/443 are taken (e.g. when trying it out locally).
# HTTP_PORT=80
# HTTPS_PORT=443
