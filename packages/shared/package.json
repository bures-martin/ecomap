{
  "name": "@ecomap/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Domain schemas, types and permission rules shared by the EcoMap API and web app.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
