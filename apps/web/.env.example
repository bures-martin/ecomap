# Copy to apps/web/.env.local (git-ignored) and fill in.

# Absolute API origin for a production build. Leave empty in development,
# where Vite proxies /api to the local API.
VITE_API_URL=

# The Danish/English language switch. Off: everyone sees the community's
# default language (Settings). Also put <LanguageMenu /> back in AppShell.vue.
VITE_LANGUAGE_SWITCH=false
