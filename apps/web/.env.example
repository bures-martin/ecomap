# Copy to apps/web/.env.local (git-ignored) and fill in.

# Mapy.com map tiles - the default background map. Get a free key at
# https://developer.mapy.com/ and restrict it to your site's domain there:
# the key is sent to the browser with every tile, like any map-tile key.
# Leave it empty and the map falls back to OpenStreetMap.
VITE_MAPY_API_KEY=
