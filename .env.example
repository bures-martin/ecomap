# Copy to .env and adjust. Never commit .env.

NODE_ENV=development
PORT=4000

# Matches docker-compose.yml.
DATABASE_URL=postgres://ecomap:ecomap@localhost:5432/ecomap

# Separate database used by the API integration tests (`npm run test -w @ecomap/api`).
# If unset, integration tests are skipped and only unit tests run.
TEST_DATABASE_URL=postgres://ecomap:ecomap@localhost:5432/ecomap_test

# Signing secret for access/refresh tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=dev-only-secret-change-me-dev-only-secret-change-me

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Comma-separated list of origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# Seed account created by `npm run db:seed`.
SEED_ADMIN_EMAIL=admin@ecomap.local
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_NAME=EcoMap Admin

# Web app (Vite) - only VITE_-prefixed vars reach the browser.
VITE_API_URL=http://localhost:4000
